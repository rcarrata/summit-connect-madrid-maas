{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/gpt-oss-20b",
  "small_model": "local/gpt-oss-20b",
  "enabled_providers": [
    "local",
    "cloud"
  ],
  "provider": {
    "local": {
      "api": "openai",
      "name": "GPU Local (gpt-oss-20b)",
      "env": [
        "OPENAI_API_KEY"
      ],
      "options": {
        "baseURL": "https://maas.__DOMAIN__/llm/gpt-oss-20b/v1"
      },
      "models": {
        "gpt-oss-20b": {
          "name": "GPT-OSS 20B (On-Prem)",
          "tool_call": true,
          "reasoning": true,
          "attachment": false,
          "temperature": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    },
    "cloud": {
      "name": "Cloud (GPT-5.5)",
      "env": [
        "OPENAI_API_KEY"
      ],
      "options": {
        "baseURL": "https://maas.__DOMAIN__/v1"
      },
      "models": {
        "gpt-4.1": {
          "name": "GPT-4.1 (Cloud)",
          "tool_call": true,
          "reasoning": false,
          "attachment": false,
          "temperature": true,
          "limit": {
            "context": 200000,
            "output": 16384
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      },
      "npm": "@ai-sdk/openai-compatible"
    }
  }
}
